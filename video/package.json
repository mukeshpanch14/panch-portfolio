{
  "name": "panch-portfolio-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HandoffReel out/handoff-reel.mp4",
    "still": "remotion still src/index.ts HandoffReel out/frame.png --frame=60",
    "reel": "remotion render src/index.ts HandoffReelV2 out/reel.mp4 --codec h264 --crf 17 --overwrite --props",
    "sfx": "node scripts/make-sfx.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@remotion/cli": "^4.0.539",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539",
    "typescript": "^7.0.2"
  }
}